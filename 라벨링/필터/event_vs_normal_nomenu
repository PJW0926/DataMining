# 8. 유사 리뷰 분석: 리뷰 문구가 서로 비슷한지 확인
# =========================================================

if SKLEARN_AVAILABLE and len(df) >= 3:
    similarity_rows = []

    for group_name, store_name in [("event", EVENT_STORE_NAME), ("normal", NORMAL_STORE_NAME)]:
        subset = df[df["group"] == group_name].copy()
        sample_n = min(200, len(subset))
        subset = subset.sample(n=sample_n, random_state=42) if len(subset) > sample_n else subset

        if len(subset) >= 3:
            vectorizer = TfidfVectorizer()
            X = vectorizer.fit_transform(subset["clean_review"])
            sim_matrix = cosine_similarity(X)

            max_sims = []
            for i in range(len(sim_matrix)):
                scores = list(sim_matrix[i])
                scores.pop(i)
                max_sims.append(max(scores))

            subset["max_similarity"] = max_sims
            similarity_rows.append(subset[["group", "store", "review_text", "max_similarity"]])

    if similarity_rows:
        similarity_df = pd.concat(similarity_rows, ignore_index=True)
        print("\n[평균 최대 유사도]")
        print(similarity_df.groupby(["group", "store"])["max_similarity"].mean().round(3))
    else:
        similarity_df = pd.DataFrame()
else:
    similarity_df = pd.DataFrame()
    print("\n[유사도 분석 생략] scikit-learn 미설치 또는 데이터 부족")


