def clean_text(text):
    text = str(text)
    # 분석용: 한글, 숫자, 영어, 공백만 남김
    text = re.sub(r"[^가-힣a-zA-Z0-9\s]", " ", text)
    text = re.sub(r"\s+", " ", text)
    return text.strip()


